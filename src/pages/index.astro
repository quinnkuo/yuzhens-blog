---
import TopicCard from '@/components/TopicCard.astro';
import WorkCard from '@/components/WorkCard.astro';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedArticles, getPublishedWorks, getTopicMap, getTopics, topicName } from '@/lib/content';
import { formatDate, withBase } from '@/lib/format';

const articles = await getPublishedArticles();
const works = await getPublishedWorks();
const topics = await getTopics();
const topicMap = await getTopicMap();

const featuredArticles = articles.filter((article) => article.data.featured).slice(0, 3);
const featuredTopics = topics.filter((topic) => topic.data.featured).slice(0, 4);
const featuredWorks = works.filter((work) => work.data.featured).slice(0, 2);
const recentItems = [
  ...articles.map((article) => ({
    title: article.data.title,
    description: article.data.description,
    date: article.data.pubDate,
    href: `/articles/${article.id}/`,
    type: '文章',
    topics: article.data.topics
  })),
  ...works.map((work) => ({
    title: work.data.title,
    description: work.data.description,
    date: work.data.date,
    href: `/works/${work.id}/`,
    type: work.data.type,
    topics: work.data.topics
  }))
].sort((a, b) => Number(b.date) - Number(a.date)).slice(0, 5);
---

<BaseLayout>
  <section class="home-intro">
    <div>
      <p class="eyebrow">Yuzhen's Blog</p>
      <h1>{SITE.description}</h1>
      <p>{SITE.tagline}</p>
    </div>
    <div class="intro-links" aria-label="主要入口">
      <a href={withBase('/articles/')}>文章</a>
      <a href={withBase('/topics/')}>主题</a>
      <a href={withBase('/works/')}>作品</a>
    </div>
  </section>

  <section class="home-board">
    <div class="home-main">
      <div class="section-heading compact">
        <p class="eyebrow">Entries</p>
        <h2>最近更新</h2>
        <a class="text-link" href={withBase('/articles/')}>全部文章</a>
      </div>
      <ol class="entry-list">
        {
          recentItems.map((item) => (
            <li>
              <article class="entry">
                <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
                <div>
                  <p>{item.type}</p>
                  <h3><a href={withBase(item.href)}>{item.title}</a></h3>
                  <p>{item.description}</p>
                  <div class="pill-row" aria-label="主题">
                    {item.topics.map((slug) => (
                      <a class="pill" href={withBase(`/topics/${slug}/`)}>{topicName(slug, topicMap)}</a>
                    ))}
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="home-side" aria-label="站点索引">
      <div class="section-heading compact">
        <p class="eyebrow">Garden</p>
        <h2>长期主题</h2>
        <a class="text-link" href={withBase('/topics/')}>查看主题</a>
      </div>
      <div class="topic-stack">
        {
          featuredTopics.map((topic) => (
            <TopicCard
              name={topic.data.name}
              summary={topic.data.summary}
              slug={topic.data.slug}
              accent={topic.data.accent}
            />
          ))
        }
      </div>

      <div class="side-block">
        <div class="section-heading compact">
          <p class="eyebrow">Works</p>
          <h2>作品</h2>
          <a class="text-link" href={withBase('/works/')}>全部作品</a>
        </div>
        <div class="stack">
          {
            featuredWorks.map((work) => (
              <WorkCard
                title={work.data.title}
                description={work.data.description}
                date={work.data.date}
                type={work.data.type}
                href={work.data.externalUrl ?? `/works/${work.id}/`}
                external={Boolean(work.data.externalUrl)}
              />
            ))
          }
        </div>
      </div>

      <div class="side-note">
        <p>精选文章</p>
        <ul>
          {featuredArticles.map((article) => (
            <li><a href={withBase(`/articles/${article.id}/`)}>{article.data.title}</a></li>
          ))}
        </ul>
      </div>
    </aside>
  </section>
</BaseLayout>
