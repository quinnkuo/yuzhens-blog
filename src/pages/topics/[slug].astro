---
import { render } from 'astro:content';
import ArticleCard from '@/components/ArticleCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import WorkCard from '@/components/WorkCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedArticles, getPublishedWorks, getTopicMap, getTopics, topicName } from '@/lib/content';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((topic) => ({
    params: { slug: topic.data.slug },
    props: { topic }
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const topicMap = await getTopicMap();
const articles = (await getPublishedArticles()).filter((article) => article.data.topics.includes(topic.data.slug));
const works = (await getPublishedWorks()).filter((work) => work.data.topics.includes(topic.data.slug));
---

<BaseLayout title={topic.data.name} description={topic.data.summary}>
  <section class="page-hero">
    <p class="eyebrow">Topic</p>
    <h1>{topic.data.name}</h1>
    <p>{topic.data.summary}</p>
  </section>

  <section class="page-section prose narrow">
    <Content />
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="eyebrow">Reading</p>
      <h2>相关文章</h2>
    </div>
    {
      articles.length > 0 ? (
        <div class="article-list">
          {articles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              date={article.data.pubDate}
              href={`/articles/${article.id}/`}
              sourceLabel={article.data.sourceLabel}
              topics={article.data.topics.map((slug) => ({ slug, name: topicName(slug, topicMap) }))}
            />
          ))}
        </div>
      ) : (
        <EmptyState title="这个主题的文章还在整理中" description="后续公开文章会逐步归到这里。" />
      )
    }
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="eyebrow">Works</p>
      <h2>相关作品</h2>
    </div>
    {
      works.length > 0 ? (
        <div class="work-grid">
          {works.map((work) => (
            <WorkCard
              title={work.data.title}
              description={work.data.description}
              date={work.data.date}
              type={work.data.type}
              href={work.data.externalUrl ?? `/works/${work.id}/`}
              external={Boolean(work.data.externalUrl)}
            />
          ))}
        </div>
      ) : (
        <EmptyState title="这个主题的作品还在整理中" description="等作品内容补齐后，会显示在这里。" />
      )
    }
  </section>
</BaseLayout>
